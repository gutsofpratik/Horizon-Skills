{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovTribe annotated proposal outline intermediate format",
  "type": "object",
  "required": [
    "source_inventory",
    "requirements",
    "outline"
  ],
  "properties": {
    "source_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "text",
          "type",
          "priority",
          "mapped_to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "mapped_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_needed": {
            "type": [
              "array",
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "outline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "volume",
          "title",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "volume": {
            "type": "string"
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "page_budget": {
            "type": [
              "number",
              "integer",
              "null"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "eval_factors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pws_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "annotations": {
            "type": [
              "array",
              "object",
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "open_questions": {
            "type": [
              "array",
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
